# По умолчанию закрываем все служебные JSON-файлы.
<FilesMatch "^(?!news\\.json$|promos\\.json$|gallery\\.json$).+\\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Публичные ленты сайта доступны только для чтения.
<FilesMatch "^(news|promos|gallery)\\.json$">
    <IfModule mod_authz_core.c>
        <RequireAll>
            Require method GET HEAD
            Require all granted
        </RequireAll>
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
